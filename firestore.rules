rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection - users can only access their own data
    match /artifacts/{appId}/users/{userId} {
      // Users can only read/write their own user document
      allow read, write: if request.auth != null && request.auth.uid == userId;
      
      // Saved resumes subcollection
      match /saved_resumes/{resumeId} {
        // Users can only read/write their own saved resumes
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Analytics subcollection
      match /analytics/{analyticsId} {
        // Users can only read/write their own analytics data
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      
      // Job applications subcollection
      match /job_applications/{applicationId} {
        // Users can only read/write their own job applications
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }
    
    // Rate limits collection - only server can write, users can read their own
    match /rate_limits/{rateLimitId} {
      allow read: if request.auth != null && request.auth.uid != null && rateLimitId.matches(request.auth.uid + '_.*');
      allow write: if false; // Only server can write
    }
    
    // Processed payments collection - only server can write, users can read their own
    match /processed_payments/{paymentId} {
      allow read: if request.auth != null;
      allow write: if false; // Only server can write
    }
    
    // Deny all other access
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
